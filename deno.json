{
  "lock": true,
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "preview": "deno run -A main.ts",
    "test": "deno test --allow-read --allow-write",
    "ci-checks": "deno fmt --check --ignore=\"components/QuoteTextDisplay.tsx\" --ignore=\"memory-bank/*\" && deno lint && deno check main.ts"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "$std/assert": "jsr:@std/assert@1",
    "$std/fs": "jsr:@std/fs@1",
    "$std/path": "jsr:@std/path@1",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.1.0",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "@preact/signals-core": "npm:@preact/signals-core@^1.12.0",
    "@testing-library/preact": "npm:@testing-library/preact@^3.2.4",
    "tailwindcss": "npm:tailwindcss@^4.1.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.0"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a", "img", "source", "body", "html", "head", "title",
      "meta", "script", "link", "style", "base", "noscript", "template"
    ],
    "types": ["vite/client"]
  }
}
