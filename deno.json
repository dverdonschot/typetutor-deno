{
  "lock": true,
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve --unstable-kv -A _fresh/server.js",
    "ci-checks": "deno fmt --check --ignore=\"components/QuoteTextDisplay.tsx\" --ignore=\"memory-bank/*\" && deno lint && deno task typecheck",
    "typecheck": "deno check main.ts client.ts",
    "test": "deno test --allow-read --allow-write"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "$std/assert": "jsr:@std/assert@^1.0.19",
    "$std/fs": "jsr:@std/fs@^1.0.24",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "@testing-library/preact": "npm:@testing-library/preact@^3.2.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@7.3.6",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
